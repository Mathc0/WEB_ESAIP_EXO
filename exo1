const produit = {
    nom: "Ordinateur portable",
    prix: 900,
    stock: 8
};

function vendreProduit(produit, quantite) {
    if (quantite <= 0) {
        return "la quantité doit être strictement positive.";
    }
    if (quantite > produit.stock) {
        return "stock insuffisant.";
    }
    produit.stock -= quantite;
    return produit.prix * quantite;
}

console.log(vendreProduit(produit, 3));
console.log(produit.stock);

