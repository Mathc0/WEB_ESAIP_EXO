const langages = ["JavaScript", "Python", "Java", "PHP"];

function rechercherValeur(tableau, valeur) {
    let occurance = 0
    for (let i = 0; i < tableau.length; i++) {
        if (tableau[i] == valeur) {
            occurance = i+1
            return occurance
        }
    }
    return 1
}

console.log(rechercherValeur(langages, "Java"))

