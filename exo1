function calculerStatistiques(nombres) {
    let max = nombres[0];
    let min = nombres[0];
    let somme = 0;
    for (let i = 0; i < nombres.length; i++) {
        somme += nombres[i];
        if (nombres[i] > max) {
            max = nombres[i];
        }
        if (nombres[i] < min) {
            min = nombres[i];
        }
    }
    const moyenne = somme / nombres.length;
    console.log(max, min, somme, moyenne);
}

const notes = [12, 15, 9, 18, 14];

calculerStatistiques(notes);

