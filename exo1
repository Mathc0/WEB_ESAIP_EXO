function compterOccurrences(tableau) {
    const occurrences = {};
    for (let i = 0; i < tableau.length; i++) {
        const valeur = tableau[i];
        occurrences[valeur] = (occurrences[valeur] || 0) + 1;
    }
    return occurrences;
}

const fruits = ["pomme", "banane", "pomme", "orange", "banane", "pomme"];

console.log(compterOccurrences(fruits));

//exo 10
const panier = [
    { nom: "Clavier", prix: 50, quantite: 2 },
    { nom: "Souris", prix: 25, quantite: 1 },
    { nom: "Écran", prix: 200, quantite: 2 }
];

function analyserPanier(panier) {
    let nombreArticles = 0;
    let prixTotal = 0;
    let produitLePlusImportant = null;
    let sousTotalMax = 0;
    const produitsSuperieursA100 = [];

    for (let i = 0; i < panier.length; i++) {
        const produit = panier[i];
        const sousTotal = produit.prix * produit.quantite;

        nombreArticles += produit.quantite;
        prixTotal += sousTotal;

        if (sousTotal > sousTotalMax) {
            sousTotalMax = sousTotal;
            produitLePlusImportant = produit.nom;
        }

        if (sousTotal > 100) {
            produitsSuperieursA100.push(produit.nom);
        }
    }

    return {
        nombreArticles,
        prixTotal,
        produitLePlusImportant,
        produitsSuperieursA100
    };
}

console.log(analyserPanier(panier));
